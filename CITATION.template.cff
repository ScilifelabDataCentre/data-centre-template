# Template citation file for your repository.
# What to do:
# 1. Replace the information in this file with the information for your own repository.
# 2. Rename this file to CITATION.cff and place it in the root of your repository
#
# More information: 
# - Development Guidelines: <FILL IN WHEN MERGED>
# - GitHub docs: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-citation-files
# ---
cff-version: 1.2.0 # Latest version at the time of writing
message: >-
  If you use this software, please cite it using the
  metadata from this file.
authors:
  - given-names: <<first-author-given-names>>
    family-names: <<first-author-family-names>>
    orcid: '<<first-author-orcid>>'
  - given-names: <<second-author-given-names>>
    family-names: <<second-author-family-names>>
    orcid: '<<second-author-orcid>>'
  - name: SciLifeLab Data Centre
    website: 'https://ror.org/04ev03g22'
title: <<repository-or-project-title>>
identifiers:
  - description: Zenodo DOI for <<repository-or-project-title>>
    type: doi
    value: <<zenodo-doi>>
repository-code: "<<repository-code-url>>"
license: "MIT"
